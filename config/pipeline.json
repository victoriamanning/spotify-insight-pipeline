{
  "pipeline_version": "spotify-insight-v1",
  "scope": {
    "description": "Classify the distinct texts of a 100,000-review uniform sample; every corpus row with an identical text reuses that saved result (cache_source_id). All 660,622 rows are ingested and accounted for.",
    "sample_size": 100000,
    "seed": "berkeley-fall-2026-assignment-5-v1",
    "priority_files": ["golden_50_to_label.csv", "checkpoint_500.csv", "analysis_10000.csv"]
  },
  "budget": {
    "spend_cap_usd": 9.0,
    "stage_caps_usd": {"enrich": 7.0, "verify": 0.75, "group": 0.25, "memo": 0.5},
    "max_minutes": 240
  },
  "roles": {
    "enrich": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "none",
      "prompt": "prompts/enrich_v1.md",
      "prompt_version": "enrich_v1",
      "schema_version": "lines_v1",
      "batch_size": 50,
      "max_output_tokens_per_review": 60,
      "workers": 1,
      "max_requests_per_minute": 300
    },
    "fallback": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "low",
      "prompt": "prompts/enrich_v1.md",
      "prompt_version": "enrich_v1",
      "schema_version": "lines_v1",
      "max_fraction": 0.02,
      "max_output_tokens": 600
    },
    "verify": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "none",
      "prompt": "prompts/verify_v1.md",
      "prompt_version": "verify_v1",
      "sample_fraction": 0.02,
      "min_sample": 50,
      "max_sample": 2000,
      "batch_size": 25,
      "max_output_tokens_per_review": 20
    },
    "group": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "low",
      "prompt": "prompts/group_v1.md",
      "prompt_version": "group_v1",
      "examples_per_issue": 8,
      "max_output_tokens": 4000
    },
    "memo": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "low",
      "prompt": "prompts/memo_v1.md",
      "prompt_version": "memo_v1",
      "top_issues": 12,
      "quotes_per_issue": 3,
      "max_output_tokens": 6000
    }
  },
  "retry": {"transient_max_attempts": 4, "backoff_base_s": 2.0, "backoff_max_s": 30.0, "invalid_output_retries": 1, "timeout_s": 90},
  "rates_file": "config/rates.csv"
}
